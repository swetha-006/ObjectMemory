# ObjectMemory local configuration
# Get a SerpApi key and place it here. Keep this file private and never commit a real key.
SERPAPI_KEY=your_serpapi_key_here
MARKET_GL=in
MARKET_HL=en
MARKET_GOOGLE_DOMAIN=google.co.in
OBJECTMEMORY_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# OpenAI ObjectMemory Assistant

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b